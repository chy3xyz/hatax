# Copy to .env for local development.
# Production (NODE_ENV=production) does not read this file. Set variables in the process environment.

# API listen port
PORT=8790

# HMAC secret. Production requires 32+ characters and rejects this placeholder.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Token lifetime, for example 8h or 7d
JWT_EXPIRES=8h

# development | production
NODE_ENV=development

# SQLite file. The directory must be writable.
# DB_PATH=./data/hatax.db

# --- Frontend dev only (bun run dev) ---
# VITE_PORT=3490
# VITE_API_BASE=http://localhost:8790
# API_URL=http://localhost:8790

# --- AI customer service (optional) ---
# Without AI_API_KEY the widget still aggregates blog/forum/courses/tasks/events.
# With a key, answers are summarized via an OpenAI-compatible API.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=25000
# AI_RATE_LIMIT=20
